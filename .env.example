# =========================================================================
# Server-Side Only Secrets (Configure in Netlify / Cloud Hosting Secrets)
# NEVER prefix these with VITE_ to prevent bundling into client-side JS.
# =========================================================================
IFM_API_KEY="your-ifm-api-key"
IFM_BASE_URL="https://api.ifm.ai/v1"
IFM_MODEL="k2-horizon"

# GEMINI_API_KEY: Optional server-side fallback
GEMINI_API_KEY=""

# =========================================================================
# Client-Side Exposed Configuration (Bundled with Vite Frontend)
# =========================================================================
# Supabase PostgreSQL Database & Authentication
# Obtain these from Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"
