# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Netlify Env.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: IFM.ai K2 Horizon / OpenAI-Compatible Engine for Thrill Copilot
# Configure in Netlify Site Settings -> Environment Variables
IFM_API_KEY="your-ifm-api-key"
IFM_BASE_URL="https://api.ifm.ai/v1"
IFM_MODEL="k2-horizon"

# Client-accessible alternatives (if client-side direct calling is enabled)
VITE_IFM_API_KEY=""
VITE_IFM_BASE_URL="https://api.ifm.ai/v1"
VITE_IFM_MODEL="k2-horizon"

# Supabase Database & Authentication Configuration
# Create a free project at https://supabase.com
# Obtain URL & anon key from Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"
